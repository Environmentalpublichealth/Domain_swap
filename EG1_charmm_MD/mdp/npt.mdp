; Stage 2/3: 2 ns NPT, BACKBONE restrained. Identical for all six systems.
;
; -DPOSRES_BB restrains protein backbone atoms ONLY. The ligand is deliberately
; FREE from here on: glycan.itp defines no POSRES_BB block, so the define finds
; nothing to apply to it. The side chains and the ligand relax against the
; equilibrating box while the fold is held, which is the point of the stage.
;
; NOT the ADHA document's 100 ns, per your instruction.
define                  = -DPOSRES_BB

integrator              = md
nsteps                  = 1000000   ; 2 ns @ 2 fs   <-- config.sh NPT_NS
dt                      = 0.002
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
cutoff-scheme           = Verlet
nstlist                 = 20

; ===== NONBONDED: CHARMM36m ==================================================
; Force-switch 1.0 -> 1.2 nm with NO analytic dispersion correction. This is not
; a style preference. CHARMM36 was parameterised WITH the force-switch potential;
; running it under a plain cutoff, or adding DispCorr on top, shifts the
; energetics measurably. The CHARMM36 carbohydrate parameters used for the
; xylohexaose come from the same release and want the same treatment, which is
; part of why the ligand is built from carb.rtp rather than from CGenFF.
vdwtype                 = cutoff
vdw-modifier            = force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2
rlist                   = 1.2
coulombtype             = PME
rcoulomb                = 1.2
pme_order               = 4
fourierspacing          = 0.16
DispCorr                = no
; =============================================================================

tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1     0.1
ref_t                   = 300     300

; C-rescale, not Parrinello-Rahman, for the RESTRAINED stage. PR is not a true
; equilibration barostat -- started from a freshly minimised box it can ring or
; blow up, and that risk is larger now that this stage is 2 ns rather than 100.
; Production below uses Parrinello-Rahman.
pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5

gen_vel                 = no

nstxout-compressed      = 5000      ; 10 ps/frame
compressed-x-grps       = System
nstenergy               = 5000
nstlog                  = 5000
