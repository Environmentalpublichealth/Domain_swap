; Stage 3/3: 200 ns unrestrained production. Identical for all six systems.
;
; NO `define` line. A stray one here would restrain the entire 200 ns and the
; RMSF would come out near zero -- silent, expensive, and entirely
; plausible-looking. submit.sh and run_md.batch both refuse to start if a define
; appears in this file.
integrator              = md
nsteps                  = 100000000 ; 200 ns @ 2 fs   <-- config.sh PROD_NS
dt                      = 0.002
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
cutoff-scheme           = Verlet
nstlist                 = 20

; ===== NONBONDED: CHARMM36m ==================================================
; Force-switch 1.0 -> 1.2 nm with NO analytic dispersion correction. This is not
; a style preference. CHARMM36 was parameterised WITH the force-switch potential;
; running it under a plain cutoff, or adding DispCorr on top, shifts the
; energetics measurably. The CHARMM36 carbohydrate parameters used for the
; xylohexaose come from the same release and want the same treatment, which is
; part of why the ligand is built from carb.rtp rather than from CGenFF.
vdwtype                 = cutoff
vdw-modifier            = force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2
rlist                   = 1.2
coulombtype             = PME
rcoulomb                = 1.2
pme_order               = 4
fourierspacing          = 0.16
DispCorr                = no
; =============================================================================

tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1     0.1
ref_t                   = 300     300
pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5
gen_vel                 = no

; 10 ps/frame -> 20001 frames over 200 ns, per system per replicate.
nstxout-compressed      = 5000
compressed-x-grps       = System
nstenergy               = 5000
nstlog                  = 5000
