define                  = -DPOSRES_BB   ; backbone-only restraints, see make_posre_backbone.sh
integrator              = md
nsteps                  = 1000000  ; 2 ns
dt                      = 0.002
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
cutoff-scheme           = Verlet
nstlist                 = 20
vdwtype                 = Cut-off
rvdw                    = 1.0
coulombtype             = PME
rcoulomb                = 1.0
DispCorr                = EnerPres
tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1     0.1
ref_t                   = 300     300
pcoupl                  = C-rescale   ; gentler than Parrinello-Rahman while pressure is still settling
pcoupltype              = isotropic
tau_p                   = 2.0
ref_p                   = 1.0
compressibility         = 4.5e-5
gen_vel                 = no
