define                  = -DPOSRES   ; heavy-atom restraints (posre.itp from pdb2gmx)
integrator              = md
nsteps                  = 250000    ; 500 ps
dt                      = 0.002
continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds
cutoff-scheme           = Verlet
nstlist                 = 20
vdwtype                 = Cut-off
rvdw                    = 1.0
coulombtype             = PME
rcoulomb                = 1.0
DispCorr                = EnerPres
tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1     0.1
ref_t                   = 300     300
pcoupl                  = no        ; constant volume
gen_vel                 = yes
gen_temp                = 300
gen_seed                = -1        ; randomize -- each replicate must get independent velocities
